# Copy to .env and fill in what you need. Every value is optional:
# with no API key the app runs in deterministic (rules-based) demo mode.

# --- Provider selection ------------------------------------------------------
# auto (default): anthropic if ANTHROPIC_API_KEY is set, else openai if
# OPENAI_API_KEY and OPENAI_MODEL are set, else rules.
# Explicit values: anthropic | openai | rules (alias: demo)
LLM_PROVIDER=auto

# --- Anthropic (Claude) ------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max  (set to "none" to omit,
# e.g. for older models that do not accept the effort parameter)
ANTHROPIC_EFFORT=medium
# Server-side refusal fallback (beta). Set false for models/platforms without it.
ANTHROPIC_REFUSAL_FALLBACK=true

# --- OpenAI or OpenAI-compatible endpoint -------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- LLM call behaviour ------------------------------------------------------
LLM_TIMEOUT_SECONDS=120
# Pipeline-level attempts (invalid output, transient errors). The SDKs also
# retry HTTP 429/5xx internally LLM_SDK_MAX_RETRIES times per attempt.
LLM_MAX_ATTEMPTS=3
LLM_SDK_MAX_RETRIES=2
LLM_MAX_TOKENS=16000
# Documents longer than this are NOT truncated; the pipeline falls back to rules.
LLM_MAX_INPUT_CHARS=200000

# --- OCR -----------------------------------------------------------------------
# Leave empty to auto-detect (PATH, then C:\Program Files\Tesseract-OCR).
TESSERACT_CMD=
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_PSM=3
# Pages with fewer extracted characters than this are treated as scanned.
OCR_MIN_CHARS_PER_PAGE=40

# --- Limits & validation ---------------------------------------------------------
MAX_PDF_PAGES=50
MAX_UPLOAD_MB=25
# How to read ambiguous numeric dates like 03/04/2025: MDY (US) or DMY
DATE_ORDER=MDY
AMOUNT_TOLERANCE=0.01

# --- Output -----------------------------------------------------------------------
OUTPUT_DIR=outputs
